# RyzenAdj (FlyGoat) para o FercDS: controla o TDP que o menu ajusta.
# Compila a versão marcada do upstream, sem mudanças no código.
# O install.sh compila este pacote com makepkg; para compilar na mão:
#   cd packaging/ryzenadj-fercds && makepkg -si

pkgname=ryzenadj-fercds
pkgver=0.19.0
pkgrel=1
pkgdesc="Adjust power management settings for Ryzen APUs (FercDS build)"
arch=('x86_64')
url="https://github.com/FlyGoat/RyzenAdj"
license=('LGPL-3.0-only')
depends=('pciutils')
makedepends=('git' 'cmake')
optdepends=('ryzen_smu-dkms-git: (AUR) acesso ao pm_table em kernels com política de memória restrita')
provides=('ryzenadj')
conflicts=('ryzenadj' 'ryzenadj-git')
source=("RyzenAdj::git+https://github.com/FlyGoat/RyzenAdj.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cmake -B build -S RyzenAdj \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm755 build/libryzenadj.so "$pkgdir/usr/lib/libryzenadj.so"
  install -Dm644 RyzenAdj/lib/ryzenadj.h "$pkgdir/usr/include/ryzenadj.h"
  install -Dm644 RyzenAdj/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
